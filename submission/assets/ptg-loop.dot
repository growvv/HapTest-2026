
digraph ptg_loop {
  graph [bgcolor="white", fontname="PingFang SC", fontsize=12, dim="1050,470", pad=0.15];
  node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=12,
        color="#4874CB", fillcolor="#EAF0FA", penwidth=1.3, margin="0.14,0.08", pin=true];
  edge [fontname="PingFang SC", fontsize=10, color="#8A94A6", arrowsize=0.7, penwidth=1.2];

  obs   [label="1  观察
observe / dumpLayout", color="#4874CB", fillcolor="#EAF0FA", pos="120,360!"];
  state [label="2  状态识别
页面 + 控件 + 内容签名", color="#30C0B4", fillcolor="#E6F7F5", pos="525,360!"];
  cand  [label="3  候选动作
属性 + 可执行性过滤", color="#EE822F", fillcolor="#FDF0E6", pos="930,360!"];
  score [label="4  策略评分
目标 · 新状态 · 历史 · 预算", color="#EE822F", fillcolor="#FDF0E6", pos="930,110!"];
  act   [label="5  受约束执行
tap / swipe / type / key", color="#75BD42", fillcolor="#EEF7E8", pos="525,110!"];
  ptg   [label="6  更新 PTG
节点 + 迁移边 + 证据", color="#E54C5E", fillcolor="#FCE9EC", pos="120,110!"];

  obs -> state;
  state -> cand;
  cand -> score;
  score -> act;
  act -> ptg;
  ptg -> obs [label="重新观察", style=dashed];
}
